<nodeDefs>
    <!-- Controller -->
    <nodeDef id="lotusctl" nls="lctl">
        <editors />
        <sts>
            <st id="ST" editor="LBOOL" />
            <st id="GV0" editor="LCOUNT" />
            <st id="GV1" editor="LBRIDGE" />
        </sts>
        <cmds>
            <sends />
            <accepts>
                <cmd id="QUERY" />
                <cmd id="DISCOVER" />
                <cmd id="ALLON" />
                <cmd id="ALLOFF" />
            </accepts>
        </cmds>
    </nodeDef>

    <!-- One BLEDOM / ELK-BLEDOM strip -->
    <nodeDef id="lotusled" nls="lled">
        <editors />
        <sts>
            <st id="ST" editor="LDIMMER" />
            <st id="GV1" editor="LRGB" />
            <st id="GV2" editor="LRGB" />
            <st id="GV3" editor="LRGB" />
            <st id="GV4" editor="LMODE" />
            <st id="GV5" editor="LPCT" />
            <st id="GV6" editor="LPCT" />
            <st id="GV7" editor="LLINK" />
        </sts>
        <cmds>
            <sends />
            <accepts>
                <cmd id="DON">
                    <p id="" editor="LDIMMER" optional="T" init="GV6" />
                </cmd>
                <cmd id="DOF" />
                <cmd id="DFON" />
                <cmd id="DFOF" />
                <cmd id="BRT" />
                <cmd id="DIM" />
                <cmd id="SETBRT">
                    <p id="" editor="LPCTMIN1" init="GV6" />
                </cmd>
                <cmd id="SETCOLOR">
                    <p id="R" editor="LRGB" init="GV1" />
                    <p id="G" editor="LRGB" init="GV2" />
                    <p id="B" editor="LRGB" init="GV3" />
                </cmd>
                <cmd id="SETPRESET">
                    <p id="" editor="LPRESET" />
                </cmd>
                <cmd id="SETCT">
                    <p id="" editor="LKELVIN" />
                </cmd>
                <cmd id="SETMODE">
                    <p id="" editor="LMODE" init="GV4" />
                </cmd>
                <cmd id="SETSPEED">
                    <p id="" editor="LPCT" init="GV5" />
                </cmd>
                <cmd id="RESEND" />
                <cmd id="QUERY" />
            </accepts>
        </cmds>
    </nodeDef>
</nodeDefs>
